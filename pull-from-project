#!/usr/bin/env bash
set -eu

project="$1"

if ! [ -d "./src/test/java/com/vaguehope/common" ] ; then
  echo "not running in own dir."
  exit 1
fi

dir="../$project"
if ! [ -d "$dir" ] ; then
  echo "not a dir: $dir"
  exit 1
fi

echo "Project: $dir"

shopt -s globstar
for f in ./src/**/*.java; do
  target="$dir/$f"
  if [ -f "$target" ] ; then
    if ! cmp -s "$target" "$f" ; then
      cp -v "$target" "$f"
    fi
  fi
done
